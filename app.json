{
  "expo": {
    "name": "Lab",
    "slug": "lab-health",
    "version": "0.9.2",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ru.repomz.lab",
      "infoPlist": {
        "NSCameraUsageDescription": "Камера нужна, чтобы сфотографировать бланк анализа.",
        "NSPhotoLibraryUsageDescription": "Доступ нужен, чтобы выбрать результат анализа из галереи."
      }
    },
    "android": {
      "package": "ru.repomz.lab",
      "permissions": [
        "CAMERA"
      ]
    },
    "androidStatusBar": {
      "backgroundColor": "#00000000",
      "translucent": true,
      "barStyle": "light-content"
    },
    "web": {
      "bundler": "metro",
      "name": "Lab — мои анализы",
      "shortName": "Lab",
      "themeColor": "#17214B",
      "backgroundColor": "#17214B",
      "display": "standalone"
    },
    "plugins": [
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Доступ нужен, чтобы выбрать результат анализа из галереи.",
          "cameraPermission": "Камера нужна, чтобы сфотографировать бланк анализа.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
